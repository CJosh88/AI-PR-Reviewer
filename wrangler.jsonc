{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "pr-reviewer",
  "main": "src/index.ts",
  "compatibility_date": "2025-09-01",
  "observability": { "enabled": true },

  // Workers AI (only used when MODEL_PROVIDER is "workers-ai")
  "ai": { "binding": "AI" },

  // One Durable Object instance per pull request
  "durable_objects": {
    "bindings": [{ "name": "PR_REVIEWER", "class_name": "PRReviewer" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["PRReviewer"] }],

  // Non-secret settings. Secrets go in with: npx wrangler secret put <NAME>
  //   GITHUB_APP_ID, GITHUB_PRIVATE_KEY, WEBHOOK_SECRET, ANTHROPIC_API_KEY (if using Claude)
  "vars": {
    "MODEL_PROVIDER": "workers-ai",                       // "anthropic" or "workers-ai"
    "ANTHROPIC_MODEL": "claude-sonnet-5-5",
    "WORKERS_AI_MODEL": "@cf/qwen/qwen3.8-27b",
    "CHECK_NAME": "AI review",                            // the name to mark as a required status check
    "DEBOUNCE_SECONDS": "20",                             // wait for pushes to settle before reviewing
    "MAX_DIFF_CHARS": "80000",                           // lower to ? for Workers AI models
    "MAX_INLINE_COMMENTS": "20",
    "BLOCK_ON_BLOCKERS": "true",                          // fail the check when a blocker is found
    "SKIP_LABEL": "skip-ai-review"
  }
}